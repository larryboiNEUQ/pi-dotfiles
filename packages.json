    {
      "source": "npm:pi-web-access@0.13.0",
      "id": "pi-web-access",
      "kind": "npm",
      "note": "Web search, fetch, GitHub clone, YouTube/PDF/video"
    },
    {
      "source": "npm:pi-codex-image-gen@0.1.12",
      "id": "pi-codex-image-gen",
      "kind": "npm",
      "note": "Codex image generation"
    },
    {
      "source": "npm:@tintinweb/pi-subagents@0.14.2",
      "id": "@tintinweb/pi-subagents",
      "kind": "npm",
      "note": "Claude Code-style subagents"
    },
    {
      "source": "https://github.com/larryboiNEUQ/pi-auto-review",
      "id": "pi-auto-review",
      "kind": "git",
      "note": "Local fork: plan-B permission system + safe-allow"
    },
    {
      "source": "npm:pi-mcp-adapter@2.11.0",
      "id": "pi-mcp-adapter",
