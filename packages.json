{
  "schemaVersion": 2,
  "meta": {
    "name": "larryboiNEUQ/pi-dotfiles",
    "description": "Shared Pi coding-agent plugin setup (packages + plan-mode + agents + spark UX)",
    "pi_version_hint": ">=0.81.0",
    "updated": "2026-08-31"
  },
  "packages": [
    {
      "id": "pi-hashline-edit",
      "kind": "npm",
      "note": "Hash-anchored line edit helpers",
      "source": "npm:pi-hashline-edit",
      "scope": "public"
    },
    {
      "id": "@ff-labs/pi-fff",
      "kind": "npm",
      "note": "FFF-backed find/grep overrides with global pi-fff.json configuration",
      "source": "npm:@ff-labs/pi-fff",
      "scope": "public"
    },
    {
      "id": "pi-web-access",
      "kind": "npm",
      "note": "Web search, fetch, GitHub clone, YouTube/PDF/video",
      "source": "npm:pi-web-access",
      "scope": "public"
    },
    {
      "id": "pi-codex-image-gen",
      "kind": "npm",
      "note": "Codex image generation",
      "source": "npm:pi-codex-image-gen",
      "scope": "public"
    },
    {
      "id": "@tintinweb/pi-subagents",
      "kind": "npm",
      "note": "Claude Code-style subagents",
      "source": "npm:@tintinweb/pi-subagents",
      "scope": "public"
    },
    {
      "id": "pi-auto-review",
      "kind": "git",
      "note": "Permission system + delegated safe-allow reviewer",
      "source": "https://github.com/larryboiNEUQ/pi-auto-review",
      "scope": "public",
      "branch": "main",
      "defaultBranch": "main",
      "legacyRefs": ["v2.4.0", "9081dc0758ac40c51b44b3a8bb44e3377a6cf421"]
    },
    {
      "id": "pi-gallery",
      "kind": "git",
      "note": "Session image gallery (/gallery)",
      "source": "git:github.com/possibly/pi-gallery",
      "scope": "public",
      "branch": "main",
      "defaultBranch": "main"
    },
    {
      "id": "pi-inline-skill-complete",
      "kind": "git",
      "note": "Mid-prompt skill autocomplete: type $name → insert /skill:name (Pi blocks mid-line / triggers)",
      "source": "https://github.com/larryboiNEUQ/pi-inline-skill-complete",
      "scope": "public",
      "branch": "main",
      "defaultBranch": "main"
    },
    {
      "id": "pi-skillful",
      "kind": "npm",
      "note": "Expand /skill:name anywhere on submit; skill visibility toggles (/skillful)",
      "source": "npm:pi-skillful",
      "scope": "public"
    },
    {
      "id": "pi-spark",
      "kind": "npm",
      "note": "TUI polish: editor border, credits, presets, recap, auto-title (footer disabled via configs/spark.json)",
      "source": "npm:pi-spark",
      "scope": "public"
    },
    {
      "id": "pi-calm",
      "kind": "git",
      "note": "Presentation-only Calm mode: hide collapsed thinking and built-in tool shells",
      "source": "git:github.com/larryboiNEUQ/pi-calm",
      "scope": "public",
      "branch": "main",
      "defaultBranch": "main"
    },
    {
      "id": "pine-of-glass",
      "kind": "npm",
      "note": "Observability extensions; pi-traceline disabled because it overrides Pi Calm tool hiding",
      "source": "npm:pine-of-glass",
      "scope": "public",
      "extensions": [
        "!extensions/pi-traceline/**"
      ]
    },
    {
      "id": "@juicesharp/rpiv-ask-user-question",
      "kind": "npm",
      "note": "Structured multi-choice questionnaire tool (ask_user_question)",
      "source": "npm:@juicesharp/rpiv-ask-user-question",
      "scope": "public"
    },
    {
      "id": "@narumitw/pi-goal",
      "kind": "npm",
      "note": "Autonomous /goal mode with goal_complete / goal_blocked",
      "source": "npm:@narumitw/pi-goal",
      "scope": "public"
    },
    {
      "id": "pi-tps-meter",
      "kind": "npm",
      "source": "npm:pi-tps-meter",
      "scope": "public"
    },
    {
      "id": "pi-cursor-auth",
      "kind": "npm",
      "source": "npm:pi-cursor-auth",
      "scope": "public"
    },
    {
      "id": "pi-devin-local",
      "kind": "npm",
      "source": "npm:pi-devin-local",
      "scope": "public"
    },
    {
      "id": "@langchain/langsmith-pi-extension",
      "kind": "npm",
      "source": "npm:@langchain/langsmith-pi-extension",
      "scope": "public"
    }
  ],
  "resources": [
    {
      "id": "settings",
      "kind": "json",
      "repo": "settings.partial.json",
      "target": "settings.json",
      "root": "agent",
      "fields": {
        "/defaultProvider": "personal",
        "/defaultModel": "personal",
        "/defaultThinkingLevel": "personal",
        "/collapseChangelog": "public",
        "/followUpMode": "public",
        "/hideThinkingBlock": "public",
        "/quietStartup": "public",
        "/steeringMode": "public",
        "/theme": "public"
      }
    },
    {
      "id": "spark",
      "kind": "json",
      "repo": "configs/spark.json",
      "target": "spark.json",
      "root": "agent",
      "fields": {
        "/footer": "public"
      }
    },
    {
      "id": "fff",
      "kind": "json",
      "repo": "configs/pi-fff.json",
      "target": "pi-fff.json",
      "root": "agent",
      "fields": {
        "/$schema": "public",
        "/mode": "public",
        "/enableFsRootScanning": "public",
        "/enableHomeDirScanning": "public",
        "/warnOnHomeDirScan": "public"
      }
    },
    {
      "id": "goal",
      "kind": "json",
      "repo": "configs/pi-goal.json",
      "target": "pi-goal.json",
      "root": "agent",
      "fields": {
        "/continuationLimits/automaticTurns": "public",
        "/continuationLimits/noProgressTurns": "public",
        "/rpc/enabled": "public"
      }
    },
    {
      "id": "calm",
      "kind": "text",
      "repo": "configs/calm",
      "target": "calm",
      "root": "agent",
      "scope": "public"
    },
    {
      "id": "permission",
      "kind": "json",
      "repo": "configs/permission.json",
      "target": "extensions/pi-permission-system/config.json",
      "root": "agent",
      "fields": {
        "/$schema": "personal",
        "/debugLog": "personal",
        "/permissionReviewLog": "personal",
        "/yoloMode": "personal",
        "/authorizerChain": "personal",
        "/permission": "personal"
      }
    },
    {
      "id": "safe-allow",
      "kind": "json",
